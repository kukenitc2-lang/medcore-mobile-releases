# ==============================================================================
# MEDCORE RELEASE DISTRIBUTION REPO — KHÔNG COMMIT ARTIFACT VÀO GIT
# ==============================================================================
# Kể từ khi chuyển sang GitHub Releases, APK + version.json là ASSETS của Release
# (xem README.md). Git chỉ track: README, .gitignore, script phát hành.
#
# Lịch sử cũ vẫn chứa blob APK (repo ~1.2 GiB). Việc dọn history (git filter-repo)
# sẽ được thực hiện riêng khi cả team đã đồng bộ — KHÔNG thêm artifact mới vào git.

# Ignore all source code & project configs
src/
android/
ios/
sql/
node_modules/
dist/
build/
package.json
package-lock.json
tsconfig.json
vite.config.ts
capacitor.config.ts
index.html
INTEGRATION_GUIDE.md
MedCore_Demo.apk
.vscode/
.idea/
.DS_Store

# Distribution artifacts KHÔNG còn nằm trong git (chỉ trên GitHub Releases)
public/
*.apk
version.json

# Chỉ track tài liệu & script phát hành
!.gitignore
!README.md
!push_release.cjs
